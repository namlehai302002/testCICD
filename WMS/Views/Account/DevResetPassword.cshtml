@{
    ViewData["Title"] = "Dev Reset Password";
    Layout = "_Layout";
}

<div class="login-page">
    <div class="login-card" style="max-width:540px;">
        <div class="login-logo">
            <h1>Dev Reset Password</h1>
            <p>Chỉ dùng khi demo/dev (Development)</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
        }

        <form method="post" asp-action="DevResetPassword">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">DevResetToken</label>
                <input type="password" name="token" class="form-control" required placeholder="Token trong User Secrets" />
            </div>
            <div class="form-group">
                <label class="form-label">UserName</label>
                <input type="text" name="userName" class="form-control" required placeholder="Ví dụ: admin@company.com" />
            </div>
            <div class="form-group">
                <label class="form-label">Mật khẩu mới</label>
                <input type="password" name="newPassword" class="form-control" required placeholder="8+ ký tự, HOA/thường/số/ký tự đặc biệt" />
            </div>
            <button type="submit" class="btn btn-danger btn-lg" style="width:100%;justify-content:center;margin-top:8px;">
                <i class="fas fa-key"></i> Reset mật khẩu
            </button>
        </form>
    </div>
</div>

