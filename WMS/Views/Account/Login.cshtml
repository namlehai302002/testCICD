@model LoginViewModel
@{ ViewData["Title"] = "Đăng Nhập"; Layout = "_Layout"; }

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="logo-icon"><img src="/images/logo.svg" alt="Logo" style="width:100%;height:100%;border-radius:16px;object-fit:cover;"/></div>
            <h1>WMS Pro</h1>
            <p>Hệ thống kho nội bộ</p>
        </div>

        <div class="user-guide" style="margin-bottom:10px;">
            <div class="user-guide-text">Nhập email và mật khẩu để bắt đầu ca làm việc.</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage</div>
        }

        <form method="post" asp-action="Login">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            <div class="form-group">
                <label class="form-label">Tài khoản (Email)</label>
                <input type="text" name="UserName" class="form-control" placeholder="Nhập email tài khoản" value="@Model.UserName" required autofocus />
            </div>
            <div class="form-group">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="Password" class="form-control" placeholder="Nhập mật khẩu" required />
            </div>
            <div class="form-group" style="display:flex;align-items:center;gap:8px;">
                <input type="checkbox" name="RememberMe" value="true" id="rememberMe" style="accent-color:var(--accent);" />
                <label for="rememberMe" style="font-size:13px;color:var(--text-secondary);cursor:pointer;">Ghi nhớ đăng nhập</label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;margin-top:8px;">
                <i class="fas fa-sign-in-alt"></i> Đăng Nhập
            </button>
        </form>
    </div>
</div>
