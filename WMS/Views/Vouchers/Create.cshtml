@model WMS.ViewModels.VoucherCreateViewModel
@{ 
    string typeName = Model.VoucherType switch { 
        1 => "Nhập Kho", 2 => "Xuất Kho", 3 => "Trả NCC", 4 => "Khách Trả", 5 => "Điều Chỉnh", 6 => "Chuyển Kho", 7 => "Nhập TP", 8 => "Xuất SX", _ => "" 
    };
    ViewData["Title"] = $"Tạo Phiếu {typeName}"; 
}

<div class="page-header">
    <div>
        <h1 class="page-title">Thêm Mới Phiếu @typeName</h1>
        <p class="page-subtitle">Nhập chính xác đầy đủ thông tin để ghi nhận vào hệ thống</p>
    </div>
    <a href="/Vouchers" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="user-guide">
    <div class="user-guide-title"><i class="fas fa-circle-info"></i> Hướng dẫn nhanh</div>
    <div class="step-list">
        <span class="step-chip"><i class="fas fa-building"></i> 1) Kiểm tra kho và đối tác</span>
        <span class="step-chip"><i class="fas fa-box"></i> 2) Chọn vật tư, nhập số lượng</span>
        <span class="step-chip"><i class="fas fa-save"></i> 3) Bấm lưu để tạo phiếu</span>
    </div>
</div>
@if (Model.VoucherType == 6)
{
    <div class="user-guide" style="margin-top:8px;">
        <div class="user-guide-title"><i class="fas fa-lightbulb"></i> Cách hiểu nhanh phiếu chuyển kho</div>
        <div style="font-size:13px; color:var(--text-muted);">
            <b>Số lượng thực chuyển</b> = <b>Số lượng xuất</b> x <b>Quy đổi ra đơn vị tồn</b>.
            Ví dụ: xuất 2 Bộ, quy đổi 10 Cái/Bộ => hệ thống chuyển tồn 20 Cái.
        </div>
    </div>
}

<form action="/Vouchers/Create" method="post" id="voucherForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="VoucherType" value="@Model.VoucherType" />
    <input type="hidden" name="ParentVoucherId" value="@Model.ParentVoucherId" />
    <div asp-validation-summary="All" class="alert alert-danger" style="margin-bottom:20px; display:none;" id="validationSummary"></div>

    @if (Model.VoucherType == 2)
    {
        <input type="hidden" name="ExportMode" id="ExportMode" value="1" />
    }

    <div class="card mb-3">
        <div class="card-header"><span class="card-title">Thông Tin Chung</span></div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Ngày Chứng Từ</label>
                    <input type="text" class="form-control" value="@DateTime.UtcNow.ToString("dd/MM/yyyy")" disabled />
                </div>
                @if(Model.VoucherType == 2)
                {
                    <div class="form-group">
                        <label class="form-label">Loại xuất</label>
                        <select id="exportModeSelect" class="form-control" onchange="setExportMode(parseInt(this.value))">
                            <option value="1" selected>Xuất nội bộ</option>
                            <option value="2">Xuất bán / ra ngoài</option>
                        </select>
                    </div>
                }
                <input type="hidden" name="WarehouseId" value="@(Model.WarehouseId > 0 ? Model.WarehouseId : Model.Warehouses.FirstOrDefault()?.WarehouseId)" />
                @if(Model.VoucherType == 6)
                {
                    <div class="form-group">
                        <label class="form-label">Kho Đích *</label>
                        <select name="DestWarehouseId" class="form-control" required
                                oninvalid="this.setCustomValidity('Vui lòng chọn kho đích.')"
                                onchange="this.setCustomValidity('')"
                                oninput="this.setCustomValidity('')">
                            <option value="">-- Chọn kho đích --</option>
                            @foreach (var w in Model.Warehouses.Where(x => x.IsActive))
                            {
                                <option value="@w.WarehouseId" selected="@(w.WarehouseId == Model.DestWarehouseId ? "selected" : null)">
                                    [@w.WarehouseCode] @w.WarehouseName
                                </option>
                            }
                        </select>
                    </div>
                }
                
                @if(Model.VoucherType is 1 or 2 or 3 or 4)
                {
                    <div class="form-group" id="partnerFieldDiv">
                        <label class="form-label" asp-for="PartnerId">Đối Tác (NCC / Khách Hàng) *</label>
                        <select name="PartnerId" class="form-control" required
                                oninvalid="this.setCustomValidity('Vui lòng chọn đối tác (NCC/Khách hàng).')"
                                onchange="this.setCustomValidity('')"
                                oninput="this.setCustomValidity('')">
                            <option value="">-- Trống / Chọn Đối Tác --</option>
                            @foreach(var p in Model.Partners) { 
                                <option value="@p.PartnerId" selected="@(p.PartnerId == Model.PartnerId ? "selected" : null)">
                                    [@p.PartnerCode] @p.PartnerName
                                </option> 
                            }
                        </select>
                        <span asp-validation-for="PartnerId" class="text-danger" style="font-size:12px;"></span>
                    </div>
                }
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Số Chứng Từ Gốc</label>
                    <input type="text" name="ReferenceNo" class="form-control" placeholder="VD: INVOICE-123" />
                </div>
                <div class="form-group" style="grid-column: span 2;">
                    <label class="form-label">Diễn giải / Ghi chú</label>
                    <input type="text" name="Description" class="form-control" placeholder="Mục đích nhập/xuất" />
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <div style="display:flex; align-items:center; gap:12px; flex:1; min-width:300px;">
                <span class="card-title" style="white-space:nowrap;">Chi Tiết Vật Tư</span>
                <div style="position:relative; flex:1; max-width:350px;">
                    <i class="fas fa-barcode" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--accent); font-size:16px;"></i>
                    <input type="text" id="barcodeInput" class="form-control" autocomplete="off" 
                           placeholder="Quét mã vạch hoặc nhập mã vật tư + Enter" 
                           style="padding-left:36px; border:2px solid var(--accent); font-size:15px; font-weight:500; letter-spacing:0.5px;" 
                           />
                    <span id="scannerLed" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); width:10px; height:10px; border-radius:50%; background:#10b981; box-shadow:0 0 6px #10b981; animation: ledPulse 2s infinite;"></span>
                </div>
                <span id="scanCount" class="badge" style="background:var(--accent); color:#fff; padding:4px 10px; border-radius:12px; font-size:12px; display:none;">0 đã quét</span>
                <button type="button" class="btn btn-sm btn-secondary" onclick="toggleWebcamScanner()"><i class="fas fa-camera"></i> Camera</button>
            </div>
            <div style="display:flex; gap:10px;">
                <label class="btn btn-sm btn-info" style="margin:0; cursor:pointer;" id="uploadBillBtn">
                    <i class="fas fa-magic"></i> Quét Hóa Đơn AI
                    <input type="file" id="billFileInput" accept="image/*" multiple style="display:none;" />
                </label>
                <label class="btn btn-sm btn-secondary" style="margin:0; cursor:pointer;" id="importExcelBtn">
                    <i class="fas fa-file-import"></i> Nhập Excel
                    <input type="file" id="excelFileInput" accept=".xlsx" style="display:none;" />
                </label>
                <a class="btn btn-sm btn-ghost" href="/Vouchers/DownloadImportTemplate" title="Tải file mẫu Excel để nhập nhanh">
                    <i class="fas fa-download"></i> File mẫu
                </a>
                <a class="btn btn-sm btn-ghost" href="/Vouchers/DownloadDemoImport100" title="Tải file Excel demo 100 dòng (dùng để thuyết trình)">
                    <i class="fas fa-database"></i> Demo 100 dòng
                </a>
                <button type="button" class="btn btn-sm btn-primary" onclick="addRow()"><i class="fas fa-plus"></i> Thêm Dòng</button>
            </div>
        </div>
        <!-- Scan toast notification -->
        <div id="scanToast" style="display:none; padding:8px 16px; font-size:13px; font-weight:600; text-align:center; transition:all 0.3s;"></div>
        <div class="table-container flat">
            <table id="linesTable" style="table-layout:fixed; width:100%;">
                <thead>
                    <tr>
                        <th style="width:50px; text-align:center;">#</th>
                        <th style="width:32%;">Vật Tư / Hàng Hóa *</th>
                        <th style="width:14%;">Đơn vị xuất</th>
                        <th style="width:12%;">Số lượng xuất *</th>
                        @if (Model.VoucherType is 1 or 4 or 7 or 6)
                        {
                            <th style="width:12%;">Số lô</th>
                        }
                        @if (Model.VoucherType == 6)
                        {
                            <th style="width:16%;">Lấy từ vị trí *</th>
                            <th style="width:16%;">Chuyển đến vị trí *</th>
                        }
                        @if (Model.VoucherType == 5)
                        {
                            <th style="width:12%;">Điều chỉnh</th>
                        }
                        @* Removed SL lỗi/thiếu column for simpler UX *@
                        <th style="width:14%;">Đơn vị tồn kho</th>
                        <th style="width:12%;">Quy đổi ra đơn vị tồn</th>
                        <th class="price-col" style="width:14%;">Đơn Giá (VNĐ)</th>
                        <th style="width:40px; text-align:center; padding:0;"></th>
                    </tr>
                </thead>
                <tbody id="linesContainer">
                    @{
                        if (Model.Lines == null || !Model.Lines.Any())
                        {
                            Model.Lines = new List<WMS.ViewModels.VoucherDetailLine> { new WMS.ViewModels.VoucherDetailLine { DefectQty = 0, TransactionQty = 0, UnitPrice = 0 } };
                        }
                    }
                    @for (int i = 0; i < Model.Lines.Count; i++)
                    {
                        var line = Model.Lines[i];
                        <tr class="line-row">
                            <td class="line-no text-center text-muted fw-700">@(i + 1)</td>
                            <td>
                                <select name="Lines[@i].ItemId" class="form-control item-select" required onchange="itemChanged(this)">
                                    <option value="">-- Chọn Vật Tư --</option>
                                    @foreach(var item in Model.Items) { 
                                        <option value="@item.ItemId" 
                                                data-uom="@item.BaseUomId" 
                                                data-uom-code="@item.BaseUom?.UomCode"
                                                data-cost="@item.UnitCost.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                                data-default-loc="@item.DefaultLocationId"
                                                data-item-type="@item.ItemType"
                                                selected="@(item.ItemId == line.ItemId ? "selected" : null)">
                                            [@item.ItemCode] @item.ItemName
                                        </option> 
                                    }
                                </select>
                            </td>
                            <td>
                                <select name="Lines[@i].TransactionUomId" class="form-control source-uom-select" onchange="sourceUomChanged(this)">
                                    <option value="">-- Chọn đơn vị xuất --</option>
                                    @foreach(var u in Model.Uoms) { 
                                        <option value="@u.UomId" 
                                                selected="@(u.UomId == line.TransactionUomId ? "selected" : null)">
                                            @u.UomCode - @u.UomName
                                        </option> 
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="text" name="Lines[@i].TransactionQty" class="form-control text-right qty-input" required value="@(line.TransactionQty > 0 ? line.TransactionQty.ToString("N0") : "")" oninput="formatAndCalc(this)" />
                            </td>
                            @if (Model.VoucherType is 1 or 4 or 7 or 6)
                            {
                                <td>
                                    <input type="text" name="Lines[@i].LotNumber" class="form-control" value="@line.LotNumber" placeholder="VD: LOT-123" />
                                </td>
                            }
                            @if (Model.VoucherType == 6)
                            {
                                <td>
                                    <select name="Lines[@i].LocationId" class="form-control loc-select" required>
                                        <option value="">-- Chọn vị trí lấy hàng --</option>
                                        @foreach (var loc in Model.Locations.Where(l => l.IsActive))
                                        {
                                            <option value="@loc.LocationId" selected="@(loc.LocationId == line.LocationId ? "selected" : null)">
                                                @loc.LocationCode
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select name="Lines[@i].DestLocationId" class="form-control dest-loc-select" required>
                                        <option value="">-- Chọn vị trí nhận hàng --</option>
                                        @foreach (var loc in Model.Locations.Where(l => l.IsActive))
                                        {
                                            <option value="@loc.LocationId" selected="@(loc.LocationId == line.DestLocationId ? "selected" : null)">
                                                @loc.LocationCode
                                            </option>
                                        }
                                    </select>
                                </td>
                            }
                            @if (Model.VoucherType == 5)
                            {
                                <td>
                                    <select name="Lines[@i].AdjustSign" class="form-control" style="font-weight:700;">
                                        <option value="1" selected="@(line.AdjustSign == 1 ? "selected" : null)">Tăng</option>
                                        <option value="-1" selected="@(line.AdjustSign == -1 ? "selected" : null)">Giảm</option>
                                    </select>
                                </td>
                            }
                            @* Removed SL lỗi/thiếu input *@
                            <td>
                                <select class="form-control dest-uom-select" disabled>
                                    <option value="">-- Đơn vị tồn kho --</option>
                                    @foreach(var u in Model.Uoms) { 
                                        <option value="@u.UomId">@u.UomCode - @u.UomName</option> 
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="text" name="Lines[@i].DestQty" class="form-control text-right dest-qty-input" style="font-weight:700; color:var(--accent);" oninput="formatCommaInput(this)" />
                                @* For non-transfer vouchers, LocationId is handled via hidden field (auto/default/suggestion). *@
                                @if (Model.VoucherType != 6)
                                {
                                    <input type="hidden" name="Lines[@i].LocationId" class="loc-input" value="@line.LocationId" />
                                }
                            </td>
                            <input type="hidden" name="Lines[@i].DefectQty" value="0" />
                            <td class="price-col">
                                <input type="text" name="Lines[@i].UnitPrice" class="form-control text-right cost-input" value="@(Model.VoucherType == 1 || Model.VoucherType == 8 ? "0" : line.UnitPrice.ToString("N0"))" @(Model.VoucherType == 1 || Model.VoucherType == 8 ? "readonly" : "") oninput="formatAndPrice(this)" />
                            </td>
                            <td style="text-align:center; vertical-align:middle; padding:0 4px;">
                                <button type="button" class="btn-delete-row" onclick="deleteRow(this)" title="Xóa dòng">
                                    <i class="fas fa-times"></i>
                                </button>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:24px;">
        <button type="submit" class="btn btn-success btn-lg" id="submitBtn"><i class="fas fa-check"></i> Lưu phiếu</button>
    </div>
</form>

<partial name="_ScannerModal" />


@section Scripts {
<style>
    /* ===== Table layout: fill all columns evenly ===== */
    #linesTable { table-layout: fixed; width: 100%; }
    #linesTable td { padding: 6px 5px; vertical-align: middle; overflow: hidden; }
    #linesTable td .form-control,
    #linesTable td .select2-container { width: 100% !important; box-sizing: border-box; }
    #linesTable .line-row { transition: background 0.15s ease; }
    #linesTable .line-row:hover { background: rgba(255,255,255,0.02); }

    /* Hide number input arrows (spinners) */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }

    .alert-danger:empty { display: none !important; }
    .d-none { display: none !important; }
    .price-col { transition: all 0.2s ease; }
    @@keyframes ledPulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    @@keyframes scanFlash {
        0% { background: rgba(16, 185, 129, 0.15); }
        100% { background: transparent; }
    }
    @@keyframes scanFlashError {
        0% { background: rgba(229, 62, 62, 0.15); }
        100% { background: transparent; }
    }
    #barcodeInput:focus {
        border-color: var(--accent) !important;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25) !important;
    }
    .scan-row-highlight {
        animation: scanFlash 1s ease-out;
    }
    /* Delete row button — compact circle */
    .btn-delete-row {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #f87171;
        font-size: 12px;
        cursor: pointer;
        border-radius: 50%;
        transition: all 0.25s cubic-bezier(.4,0,.2,1);
        opacity: 0.5;
        padding: 0;
    }
    .line-row:hover .btn-delete-row {
        opacity: 0.85;
    }
    .btn-delete-row:hover {
        opacity: 1;
        background: rgba(239, 68, 68, 0.2);
        border-color: #ef4444;
        color: #ef4444;
        transform: scale(1.15);
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.25);
    }
    .btn-delete-row:active {
        transform: scale(0.9);
    }
</style>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<style>
    /* Select2 Light Theme Match */
    .select2-container--default .select2-selection--single {
        background-color: #fff !important;
        border: 1px solid var(--border, #d7e1ee) !important;
        height: 38px !important;
