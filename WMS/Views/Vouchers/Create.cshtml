                                        <th>Khu</th>
                                        <th>Còn trống</th>
                                        <th>% đầy</th>
                                        <th style="text-align:center;">Chọn</th>
                                    </tr></thead>
                                    <tbody>${tableRows}</tbody>
                                </table>
                            </div>
                            <div class="loc-suggest-footer">
                                ${bestLoc ? `<button type="button" class="btn btn-sm btn-success" onclick="selectSuggestedLocation(${bestLoc.locationId}, '${bestLoc.locationCode}')">📦 Tự động phân bổ</button>` : ''}
                                <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('locationSuggestionModal').style.display='none'">Đóng</button>
                            </div>
                        </div>
                    `;
                    modal.innerHTML = contentHtml;
                }

                // Store reference to location select
                modal.dataset.locSelectName = locSelect.getAttribute('name');
            })
            .catch(err => {
                console.error('Error loading suggestions:', err);
                modal.innerHTML = `
                    <div class="loc-suggest-modal" style="padding:40px;text-align:center;">
                        <i class="fas fa-circle-exclamation" style="font-size:26px; display:block; margin-bottom:10px; color: var(--danger);"></i>
                        <div class="fw-700" style="margin-bottom:12px;">Lỗi tải dữ liệu gợi ý</div>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('locationSuggestionModal').style.display='none'">Đóng</button>
                    </div>
                `;
            });
        
        // Store which loc select we're modifying
        window._currentLocSelect = locSelect;
        
        // Close modal on outside click
        modal.onclick = (e) => {
            if (e.target === modal) modal.style.display = 'none';
        };
    }
    
    function selectSuggestedLocation(locationId, locationCode) {
        if (window._currentLocSelect) {
            window._currentLocSelect.value = locationId;
            validateLocation(window._currentLocSelect);
        }
        document.getElementById('locationSuggestionModal').style.display = 'none';
    }

    function validateLocation(locSelect) {
        const row = locSelect.closest('tr');
        const locId = locSelect.value;
        const itemSelect = row.querySelector('.item-select');
        const itemId = itemSelect.value;
        const itemText = itemSelect.selectedOptions[0]?.text.trim() || "Vật tư";

        if (!locId || !itemId) return;

        // 1. Check same-form conflicts
        let conflictInForm = false;
        let conflictItemName = "";
        document.querySelectorAll('.line-row').forEach(otherRow => {
            if (otherRow === row) return;
            const otherLocSelect = otherRow.querySelector('.loc-select');
            const otherItemSelect = otherRow.querySelector('.item-select');
            
            if (otherLocSelect && otherLocSelect.value === locId) {
                if (otherItemSelect.value && otherItemSelect.value !== itemId) {
                    conflictInForm = true;
                    // Get name
                    conflictItemName = otherItemSelect.selectedOptions[0]?.text.trim();
                }
            }
        });

        if (conflictInForm) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Xung đột vị trí', `Vị trí ${locSelect.selectedOptions[0].text} đang được dùng để xếp [${conflictItemName}] ở dòng khác trong phiếu này. Tránh xếp chung 2 vật tư vào 1 ô/bồn.`, 'warning');
            } else {
                alert(`Xung đột vị trí: Vị trí ${locSelect.selectedOptions[0].text} đang được dùng để xếp [${conflictItemName}] ở dòng khác trong phiếu này.`);
            }
            locSelect.value = ''; // Reset
            return;
        }

        // 2. Check DB conflicts
        fetch(`/Warehouses/CheckLocationConflict?locationId=${locId}&itemId=${itemId}`)
            .then(r => r.json())
            .then(res => {
                if (res.conflict) {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Vị trí đã có hàng', `Vị trí ${locSelect.selectedOptions[0].text} đang chứa ${res.conflictItemName}. Không thể xếp [${itemText}] chung vào đây.`, 'error');
                    } else {
                        alert(`Vị trí đã có hàng: Vị trí ${locSelect.selectedOptions[0].text} đang chứa ${res.conflictItemName}.`);
                    }
                    locSelect.value = ''; // Reset
                }
            })
            .catch(err => console.error(err));
    }

    // --- FORM SUBMIT ---
    document.getElementById('voucherForm').addEventListener('submit', function(e) {
        let isValid = true;
        
        // Thêm fallback an toàn trong trường hợp jQuery validation chưa load kịch bản 
        if (typeof $ !== 'undefined' && $.fn && $.fn.valid) {
            isValid = $(this).valid();
        }

        // Custom validation: PartnerId required (đổi tooltip mặc định sang popup đẹp)
        const requiredPartner = this.querySelector('select[name="PartnerId"][required]');
        if (requiredPartner && (!requiredPartner.value || requiredPartner.value === "")) {
            e.preventDefault();
            if (typeof Swal !== 'undefined') {
                Swal.fire('Thiếu thông tin', 'Vui lòng chọn Đối Tác (NCC / Khách Hàng) trước khi lưu phiếu.', 'warning');
            } else {
                alert('Vui lòng chọn Đối Tác (NCC / Khách Hàng) trước khi lưu phiếu.');
            }
            requiredPartner.focus();
            return;
        }

        if (isValid) {
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('submitBtn').innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang Xử Lý...';
        } else {
            document.getElementById('validationSummary').style.display = 'block';
            e.preventDefault();
        }
    });

    // ============================================================
    // BARCODE SCANNER GUN INTEGRATION
    // USB/Bluetooth scanners act like keyboards:
    //   1. They "type" the barcode digits rapidly
    //   2. Then send Enter key
    //   3. Input field must be focused to receive input
    // ============================================================
    initializeExportTabs();
    const bInput = document.getElementById('barcodeInput');

    // Auto-focus on page load
    if (bInput) {
        bInput.focus();

        // Re-focus when clicking anywhere on the page (except other inputs)
        document.addEventListener('click', function(e) {
            // Ignore if clicking on select2 search box or select2 elements
            if (e.target.closest('.select2-container')) return;

            if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT' && e.target.tagName !== 'TEXTAREA' && e.target.tagName !== 'BUTTON') {
                bInput.focus({ preventScroll: true });
            }
        });

        // Handle barcode input (Enter key from scanner gun or manual)  
        bInput.addEventListener('keypress', async function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                const barcode = this.value.trim();
                this.value = '';
                if (barcode) {
                    // Flash the LED
                    const led = document.getElementById('scannerLed');
                    if (led) {
                        led.style.background = '#fbbf24';
                        led.style.boxShadow = '0 0 8px #fbbf24';
                    }
                    
                    await processBarcode(barcode);
                    
                    // Reset LED
                    if (led) {
                        setTimeout(() => {
                            led.style.background = '#10b981';
                            led.style.boxShadow = '0 0 6px #10b981';
                        }, 500);
                    }
                }
                // Always re-focus for next scan
                this.focus();
            }
        });
    }

    // --- CORE BARCODE PROCESSING ---
    async function processBarcode(barcode) {
        if (!barcode) return false;
        console.log('[Scanner] Looking up:', barcode);

        try {
            const res = await fetch(`/Items/GetItemByBarcode?barcode=${encodeURIComponent(barcode)}`);
            
            if (res.ok) {
                const item = await res.json();
                console.log('[Scanner] ✓ Found:', item.itemCode, item.itemName);

                // Check if already in list → increment quantity
                let foundRow = null;
                document.querySelectorAll('.line-row').forEach(row => {
                    const select = row.querySelector('.item-select');
                    if (select.value == item.itemId) foundRow = row;
                });

                if (foundRow) {
                    // DUPLICATE SCAN → increment qty
                    const qtyInput = foundRow.querySelector('input[name$=".TransactionQty"]');
                    const newQty = parseCommaNumber(qtyInput.value) + 1;
                    qtyInput.value = formatWithCommas(newQty.toString());
                    
                    foundRow.classList.remove('scan-row-highlight');
                    void foundRow.offsetWidth; // Force reflow
                    foundRow.classList.add('scan-row-highlight');

                    beepDuplicate();
                    updateScanCount();
                    showScanToast(`✓ ${item.itemCode} — SL tăng lên ${newQty}`, 'duplicate');
                    return true;
                }

                // NEW ITEM → add to table
                const tbody = document.getElementById('linesContainer');
                let firstRow = tbody.querySelector('.line-row');
                let isFirstBlank = firstRow && firstRow.querySelector('.item-select').value === "";
                
                let targetRow = isFirstBlank ? firstRow : null;
                if (!targetRow) {
                    addRow();
                    const rows = document.querySelectorAll('.line-row');
                    targetRow = rows[rows.length - 1];
                }

                const select = targetRow.querySelector('.item-select');
                select.value = item.itemId;
                itemChanged(select); 
                
                targetRow.querySelector('input[name$=".TransactionQty"]').value = 1;
                calculateRowPrice(targetRow);

                // Highlight the new row
                targetRow.classList.add('scan-row-highlight');

                beepSuccess();
                updateScanCount();
                showScanToast(`✓ Đã thêm: [${item.itemCode}] ${item.itemName}`, 'success');
                return true;

            } else {
                // NOT FOUND
                console.warn('[Scanner] ✗ Not found:', barcode);
                beepError();
                showScanToast(`✗ Không tìm thấy vật tư với mã: ${barcode}`, 'error');
                return false;
            }
        } catch (err) {
            console.error('[Scanner] Network error:', err);
            beepError();
            showScanToast(`✗ Lỗi kết nối — thử lại`, 'error');
            return false;
        }
    }

    // --- WEBCAM SCANNER (camera on mobile) ---
    function toggleWebcamScanner() {
        openScannerModal(async (decodedText) => {
            console.log('[Camera] Scanned:', decodedText);
            const success = await processBarcode(decodedText);
            const statusEl = document.getElementById('scanStatus');
            if (statusEl) {
                if (success) {
                    statusEl.textContent = '✓ Đã thêm: ' + decodedText + ' — Tiếp tục quét...';
                    statusEl.style.color = 'var(--accent, #10b981)';
                } else {
                    statusEl.textContent = '✗ Không tìm thấy: ' + decodedText;
                    statusEl.style.color = 'var(--danger, #e53e3e)';
                }
                statusEl.style.display = 'block';
            }
        });
    }


    async function applyMappedItemsToLines(items) {
        if (!items || items.length === 0) return { newItemNames: [], matchedCount: 0 };

        // Destroy Select2 BEFORE processing to avoid DOM conflicts
        if (typeof $ !== 'undefined') {
            $('.item-select, .source-uom-select').each(function() {
                if ($(this).hasClass('select2-hidden-accessible')) {
                    $(this).select2('destroy');
                }
            });
        }

        const tbody = document.getElementById('linesContainer');
        let firstRow = tbody.querySelector('.line-row');
        let isFirstBlank = firstRow && firstRow.querySelector('.item-select').value === "";
        let newItemNames = [];
        let matchedCount = 0;

        items.forEach((item, index) => {
            let targetRow = null;
            if (index === 0 && isFirstBlank) {
                targetRow = firstRow;
            } else {
                const newRow = document.querySelector('.line-row').cloneNode(true);
                newRow.querySelectorAll('[name]').forEach(el => {
                    el.name = el.name.replace(/\[\d+\]/, `[${lineIdx}]`);
                    if (el.tagName === 'INPUT') {
                        if (el.className.includes('loc-input')) el.value = '';
                        else if (el.type === 'hidden') { /* keep */ }
                        else el.value = '';
                    } else if (el.tagName === 'SELECT') {
                        if (el.className.includes('item-select')) el.value = '';
                        if (el.className.includes('source-uom-select')) el.value = '';
                        if (el.className.includes('loc-select')) el.value = '';
                    }
                });
                const destUom = newRow.querySelector('.dest-uom-select');
                if (destUom) destUom.value = '';
                const destQty = newRow.querySelector('.dest-qty-input');
                if (destQty) destQty.value = '';
                const qtyInput = newRow.querySelector('.qty-input');
                if (qtyInput) qtyInput.oninput = function() { formatAndCalc(this); };
                const priceInput = newRow.querySelector('.cost-input');
                if (priceInput) priceInput.oninput = function() { formatAndPrice(this); };
                const itemSelect = newRow.querySelector('.item-select');
                if (itemSelect) itemSelect.onchange = function() { itemChanged(this); };
                const sourceUomSelect = newRow.querySelector('.source-uom-select');
                if (sourceUomSelect) sourceUomSelect.onchange = function() { sourceUomChanged(this); };
                tbody.appendChild(newRow);
                lineIdx++;
                targetRow = newRow;
            }

            const select = targetRow.querySelector('.item-select');
            let matched = Array.from(select.options).find(o => o.value == item.ItemId);
            if (!matched) {
                const newText = `[${item.ItemCode}] ${item.ItemName}`;
                document.querySelectorAll('.item-select').forEach(sel => {
                    const opt = new Option(newText, item.ItemId);
                    opt.dataset.uom = item.BaseUomId || '';
                    opt.dataset.cost = item.UnitPrice || 0;
                    sel.add(opt);
                });
            }

            select.value = item.ItemId;
            itemChanged(select);

            if (item.IsNew) newItemNames.push(`[${item.ItemCode}] ${item.ItemName}`);
            else matchedCount++;

            const qtyVal = (item.Quantity ?? item.quantity ?? 1);
            targetRow.querySelector('input[name$=".TransactionQty"]').value = formatWithCommas(qtyVal.toString());

            const unitPriceVal = (item.UnitPrice ?? item.unitPrice ?? 0);
            if (unitPriceVal) targetRow.querySelector('.cost-input').value = formatWithCommas(unitPriceVal.toString());

            if (item.LocationId) {
                const locSel = targetRow.querySelector('.loc-select');
                if (locSel) locSel.value = item.LocationId;
            }
            if (item.DefectQty != null) {
                const defectInput = targetRow.querySelector('input[name$=".DefectQty"]');
                if (defectInput) defectInput.value = formatWithCommas((item.DefectQty || 0).toString());
            }

            if (item.LotNumber != null || item.lotNumber != null) {
                const lotVal = (item.LotNumber ?? item.lotNumber ?? '').toString();
                const lotInput = targetRow.querySelector('input[name$=".LotNumber"]');
                if (lotInput) lotInput.value = lotVal;
            }
        });

        if (typeof initSelect2 === 'function') initSelect2();
        refreshLineNumbers();
        return { newItemNames, matchedCount };
    }

    document.getElementById('excelFileInput')?.addEventListener('change', async function() {
        const file = this.files?.[0];
        if (!file) return;

        const btn = document.getElementById('importExcelBtn');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang nhập...';
        btn.style.pointerEvents = 'none';

        const formData = new FormData();
        formData.append('file', file);

        try {
            const token = document.querySelector('#voucherForm input[name="__RequestVerificationToken"]')?.value;
            const response = await fetch('/Vouchers/ImportLinesExcel', {
                method: 'POST',
                headers: token ? { 'RequestVerificationToken': token } : {},
                body: formData
            });

            if (!response.ok) {
                Swal.fire('Lỗi Import Excel', await response.text(), 'error');
                return;
            }

            const res = await response.json();
            let items = [];
            try { items = JSON.parse(res.data); } catch(e) {}
            if (!items || items.length === 0) {
                Swal.fire('Không có dữ liệu', 'File Excel không có dòng hợp lệ.', 'warning');
                return;
            }

            const summary = await applyMappedItemsToLines(items);
            const msg = `Đã nhập ${items.length} dòng từ Excel!\n✅ Khớp vật tư: ${summary.matchedCount}\n🆕 Tạo mới: ${summary.newItemNames.length}`;
            Swal.fire({
                title: 'Import Excel thành công!',
                html: `<div style="text-align:left; white-space:pre-line; font-size:14px;">${msg}</div>`,
                icon: 'success',
                confirmButtonColor: '#10b981',
                background: '#1a1f2e',
                color: '#e2e8f0',
                customClass: { popup: 'swal-dark' }
            });
        } catch (e) {
            Swal.fire('Lỗi Import', 'Đã xảy ra lỗi: ' + e, 'error');
        } finally {
            btn.innerHTML = originalHtml;
            btn.style.pointerEvents = 'auto';
            this.value = '';
        }
    });

    document.getElementById('billFileInput').addEventListener('change', async function() {
        const files = Array.from(this.files || []);
        if (!files.length) return;

        const btn = document.getElementById('uploadBillBtn');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> OCR ${files.length} bill...`;
        btn.style.pointerEvents = 'none';

        const token = document.querySelector('#voucherForm input[name="__RequestVerificationToken"]')?.value;
        const allItems = [];

        try {
            Swal.fire({
                title: 'Đang quét hóa đơn...',
                html: `0/${files.length} bill`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#1a1f2e',
                color: '#e2e8f0',
                customClass: { popup: 'swal-dark' }
            });

            for (let i = 0; i < files.length; i++) {
                Swal.update({ html: `${i + 1}/${files.length} bill` });
                const formData = new FormData();
                formData.append('file', files[i]);
                const response = await fetch('/Vouchers/AnalyzeReceipt', {
                    method: 'POST',
                    headers: token ? { 'RequestVerificationToken': token } : {},
                    body: formData
                });
                if (!response.ok) throw new Error(await response.text());
                const res = await response.json();
                let items = [];
                try { items = JSON.parse(res.data); } catch(e) {}
                if (items && items.length) allItems.push(...items);
            }

            Swal.close();

            if (!allItems.length) {
                Swal.fire('Không Thấy Dữ Liệu', 'Không nhận diện được mặt hàng hợp lệ nào từ các hóa đơn.', 'warning');
                return;
            }

            // Merge by ItemId + UnitPrice
            const map = new Map();
            for (const it of allItems) {
                const key = `${it.ItemId || 0}__${it.UnitPrice || 0}`;
                const existing = map.get(key);
                const q = (it.Quantity || it.quantity || 1);
                if (!existing) map.set(key, { ...it, Quantity: q });
                else existing.Quantity = (existing.Quantity || 0) + q;
            }
            const merged = Array.from(map.values());

            const summary = await applyMappedItemsToLines(merged);
            const msg = `Đã quét ${files.length} bill.\nTổng dòng nhận diện: ${allItems.length}\nSau gộp: ${merged.length}\n✅ Khớp vật tư: ${summary.matchedCount}\n🆕 Tạo mới: ${summary.newItemNames.length}`;
            Swal.fire({
                title: 'Quét nhiều hóa đơn xong!',
                html: `<div style="text-align:left; white-space:pre-line; font-size:14px;">${msg}</div>`,
                icon: 'success',
                confirmButtonColor: '#10b981',
                background: '#1a1f2e',
                color: '#e2e8f0',
                customClass: { popup: 'swal-dark' }
            });
        } catch (e) {
            Swal.close();
            Swal.fire('Lỗi Quét Hóa Đơn', '' + e, 'error');
        } finally {
            btn.innerHTML = originalHtml;
            btn.style.pointerEvents = 'auto';
            this.value = '';
        }
    });


</script>
