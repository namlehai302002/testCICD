@model WMS.Models.Voucher
@{
    ViewData["Title"] = $"Phiếu: {Model.VoucherCode}";
    // Helper chuyển UTC sang giờ VN
    var vnTz = TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time");
    Func<DateTime, string> toVN = (dt) => TimeZoneInfo.ConvertTimeFromUtc(dt, vnTz).ToString("dd/MM/yyyy HH:mm");
    Func<DateTime, string> toVNDate = (dt) => TimeZoneInfo.ConvertTimeFromUtc(dt, vnTz).ToString("dd/MM/yyyy");
    var canReviewInbound = (User.IsInRole("Admin") || User.IsInRole("Manager")) && !Model.IsPosted && (Model.VoucherType == 1 || Model.VoucherType == 4 || Model.VoucherType == 7);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Chi Tiết Phiếu</h1>
        <p class="page-subtitle">@Model.VoucherCode | Lập ngày @toVN(Model.CreatedAt)</p>
    </div>
    <div class="page-actions">
        @if ((User.IsInRole("Admin") || User.IsInRole("Manager")) && Model.IsPartial && (Model.VoucherType == 1 || Model.VoucherType == 4 || Model.VoucherType == 7))
        {
            <a href="/Vouchers/ReplenishDefect/@Model.VoucherId" class="btn btn-warning"><i class="fas fa-exclamation-triangle"></i> Bù Hàng Lỗi</a>
        }
        @if (canReviewInbound)
        {
            <form method="post" action="/Vouchers/Approve" style="display:inline;" id="approveForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.VoucherId" />
                <input type="hidden" name="reviewResult" id="reviewResultInput" value="2" />
                <input type="hidden" name="responsibilityScore" id="responsibilityScoreInput" value="0" />
                <input type="hidden" name="reviewNote" id="reviewNoteInput" value="" />
                <button type="button" class="btn btn-success" id="approveBtn"><i class="fas fa-check-double"></i> Tăng tồn</button>
            </form>
        }
        @if ((User.IsInRole("Admin") || User.IsInRole("Manager")) && !Model.IsPosted && (Model.VoucherType == 2 || Model.VoucherType == 3 || Model.VoucherType == 6 || Model.VoucherType == 8))
        {
            <form method="post" action="/Vouchers/ConfirmForPicking" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.VoucherId" />
                <button type="submit" class="btn btn-warning"><i class="fas fa-layer-group"></i> Xác nhận tạo nhiệm vụ lấy hàng</button>
            </form>
            <form method="post" action="/Vouchers/PostReservedOutbound" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.VoucherId" />
                <input type="hidden" name="cancelRemaining" value="false" />
                <button type="submit" class="btn btn-success"><i class="fas fa-check-double"></i> Chốt phần đã lấy</button>
            </form>
            <form method="post" action="/Vouchers/PostReservedOutbound" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.VoucherId" />
                <input type="hidden" name="cancelRemaining" value="true" />
                <button type="submit" class="btn btn-secondary"><i class="fas fa-ban"></i> Chốt & hủy phần còn lại</button>
            </form>
        }

        <button onclick="window.print()" class="btn btn-secondary"><i class="fas fa-print"></i> In Phiếu</button>
        <a href="/Vouchers" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
    </div>
</div>

@if (Model.VoucherType is 2 or 3 or 6 or 8)
{
    <div class="user-guide">
        <div class="user-guide-title"><i class="fas fa-route"></i> Luồng xuất kho dễ hiểu</div>
        <div class="step-list">
            <span class="step-chip"><i class="fas fa-layer-group"></i> 1) Xác nhận tạo nhiệm vụ lấy hàng</span>
            <span class="step-chip"><i class="fas fa-barcode"></i> 2) Quét mã và hoàn tất nhiệm vụ lấy</span>
            <span class="step-chip"><i class="fas fa-check-circle"></i> 3) Chốt xuất kho</span>
        </div>
    </div>
}
else
{
    <div class="user-guide">
        <div class="user-guide-title"><i class="fas fa-clipboard-check"></i> Luồng nhập kho dễ hiểu</div>
        <div class="step-list">
            <span class="step-chip"><i class="fas fa-file-circle-plus"></i> 1) Tạo phiếu</span>
            <span class="step-chip"><i class="fas fa-check-double"></i> 2) Duyệt/Kiểm kho</span>
            <span class="step-chip"><i class="fas fa-box-open"></i> 3) Tồn kho cập nhật</span>
        </div>
    </div>
}

<div class="grid-2 mb-3">
    <div class="card">
        <div class="card-header"><span class="card-title">Thông Tin Giao Dịch</span></div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">Loại Phiếu</div>
                    <div class="detail-value"><span class="badge badge-info text-uppercase">@Model.VoucherTypeName</span></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Kho Quản Lý</div>
                    <div class="detail-value text-accent">@Model.Warehouse?.WarehouseName</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Ngày Chứng Từ</div>
                    <div class="detail-value">@toVNDate(Model.VoucherDate)</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Trạng Thái</div>
                    <div class="detail-value"><span class="badge @Model.StatusBadgeClass">@Model.StatusDisplay</span></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Tiến độ xuất</div>
                    <div class="detail-value">
                        @(Model.FulfillmentStatus switch {
                            1 => "Mới tạo",
                            2 => "Chờ lấy hàng",
                            3 => "Đang lấy hàng",
                            4 => "Đã lấy đủ",
                            5 => "Hoàn tất",
                            6 => "Xuất một phần",
                            _ => "N/A"
                        })
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Đối Tác</div>
                    <div class="detail-value">@(Model.Partner?.PartnerName ?? "---")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Số Chứng Từ Gốc</div>
                    <div class="detail-value">@(string.IsNullOrEmpty(Model.ReferenceNo) ? "---" : Model.ReferenceNo)</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mt-3">
                    <div class="detail-label">Diễn Giải</div>
                    <div class="detail-value" style="font-size:13px; font-weight:400;">@Model.Description</div>
                </div>
            }
        </div>
    </div>
    <div class="card">
        <div class="card-header"><span class="card-title">Thông Tin Thanh Toán & Nguồn Lập</span></div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">Tổng Mặt Hàng</div>
                    <div class="detail-value">@Model.TotalLines dòng</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">Nguồn Lập Phiếu</div>
                    <div class="detail-value"><span class="badge badge-accent">@Model.SourceTypeName</span></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Người Lập</div>
                    <div class="detail-value">@Model.CreatedBy</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Người kiểm</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.ReviewedBy) ? "---" : Model.ReviewedBy)</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Kết quả kiểm</div>
                    <div class="detail-value">
                        @(Model.ReviewResult switch {
                            2 => "Đạt",
                            3 => "Có sai lệch",
                            _ => "Chờ kiểm"
                        })
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Điểm trách nhiệm</div>
                    <div class="detail-value">@Model.ResponsibilityScore.ToString("N0")</div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ReviewNote))
            {
                <div class="mt-2">
                    <div class="detail-label">Ghi chú kiểm</div>
                    <div class="detail-value" style="font-size:13px; font-weight:400;">@Model.ReviewNote</div>
                </div>
            }
            
            @if (Model.IsCancelled)
            {
                <div class="alert alert-danger mt-3" style="margin-bottom:0;">
                    <div>
                        <strong><i class="fas fa-ban"></i> Phiếu đã bị hủy</strong><br/>
                        <small>Hủy bởi: @Model.CancelledBy lúc @(Model.CancelledAt.HasValue ? toVN(Model.CancelledAt.Value) : "")</small><br/>
                        <small>Lý do: @Model.CancelReason</small>
                    </div>
                </div>
            }
            else if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <form method="post" action="/Vouchers/Cancel" class="mt-3" id="cancelForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.VoucherId" />
                    <div style="display:flex;gap:10px;">
                        <input type="text" name="cancelReason" class="form-control" placeholder="Nhập lý do hủy phiếu..." required id="cancelReasonInput" />
                        <button type="button" class="btn btn-danger" style="white-space:nowrap;" id="cancelBtn"><i class="fas fa-trash"></i> Hủy Phiếu</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><span class="card-title"><i class="fas fa-list"></i> Chi Tiết Hàng Hóa Dịch Vụ</span></div>
    <div class="table-container flat">
        <table>
            <thead>
                <tr>
                    <th style="width:40px;text-align:center;">#</th>
                    <th>Mã VT</th>
                    <th>Tên Vật Tư</th>
                    <th>Vị Trí</th>
                    <th style="text-align:right;">SL</th>
                    <th>ĐVT</th>
                    <th style="text-align:right;">Đơn Giá</th>
                    <th style="text-align:right;">Thành Tiền</th>
                    <th class="no-print">Ghi Chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Details.OrderBy(d => d.LineNumber))
                {
                    <tr style="@(Model.IsCancelled ? "opacity:0.6;" : "")">
                        <td class="text-center text-muted">@d.LineNumber</td>
                        <td class="td-code text-accent">@d.Item?.ItemCode</td>
                        <td class="td-name">@d.Item?.ItemName</td>
                        <td><span class="badge badge-purple">@(d.Location?.LocationCode ?? "Chờ xếp kho")</span></td>
                        <td class="td-number fw-600 text-success"
                            data-base-qty="@d.BaseQty.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-defect-qty="@d.DefectBaseQty.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-trans-qty="@d.TransactionQty.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-defect-trans-qty="@d.DefectQty.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            @d.BaseQty.ToString("N0")
                            @if (d.BaseQty != d.TransactionQty)
                            {
                                <br/><small class="text-muted" style="font-size:11px; font-weight:400;">(@d.TransactionQty.ToString("N0") × @((d.TransactionQty > 0 ? d.BaseQty / d.TransactionQty : 1).ToString("N0")))</small>
                            }
                            @if (d.DefectBaseQty > 0 || d.DefectQty > 0)
                            {
                                <br/><small class="text-danger" style="font-size:11px; font-weight:600;">Lỗi: @d.DefectBaseQty.ToString("N0")</small>
                            }
                            @if (canReviewInbound)
                            {
                                var defectMax = d.ConversionRate == 0 ? d.TransactionQty : (d.BaseQty / Math.Abs(d.ConversionRate));
                                <form method="post" action="/Vouchers/UpdateInboundDefect" class="no-print defect-edit-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.VoucherId" />
                                    <input type="hidden" name="detailId" value="@d.VoucherDetailId" />
                                    <input class="form-control defect-qty-input" type="number" name="defectQty" min="0" max="@defectMax.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" step="0.0001" value="@d.DefectQty.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)" />
                                    <input class="form-control defect-note-input" type="text" name="reviewNote" placeholder="Lý do chỉnh" />
                                    <button class="btn btn-sm btn-secondary defect-save-btn" type="submit">Lưu lệch</button>
                                </form>
                            }
                        </td>
                        <td>
                            @(d.Item?.BaseUom?.UomCode ?? d.TransactionUom?.UomCode ?? "N/A")
                        </td>
                        <td class="td-number">@d.UnitPrice.ToString("N0")</td>
                        <td class="td-number fw-600">@d.LineAmount.ToString("N0")</td>
                        <td class="text-muted no-print" style="font-size:12px;">@d.Notes</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:700; background:rgba(255,255,255,0.03);">
                    <td colspan="7" style="text-align:right; padding:14px;">TỔNG CỘNG:</td>
                    <td class="td-number text-success" style="font-size:16px;">@Model.TotalAmount.ToString("N0") VNĐ</td>
                    <td class="no-print"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Print-only: Khung chữ ký -->
<div class="print-signatures">
    <table style="width:100%; margin-top:40px; border:none;">
        <tr style="text-align:center;">
            <td style="width:33%; border:none; padding:20px;">
                <div style="font-weight:700; margin-bottom:60px;">Người Lập Phiếu</div>
                <div style="font-style:italic; color:#666;">(Ký và ghi rõ họ tên)</div>
            </td>
            <td style="width:33%; border:none; padding:20px;">
                <div style="font-weight:700; margin-bottom:60px;">Thủ Kho</div>
                <div style="font-style:italic; color:#666;">(Ký và ghi rõ họ tên)</div>
            </td>
            <td style="width:33%; border:none; padding:20px;">
                <div style="font-weight:700; margin-bottom:60px;">Kế Toán</div>
                <div style="font-style:italic; color:#666;">(Ký và ghi rõ họ tên)</div>
            </td>
        </tr>
    </table>
</div>

<style>
    .defect-edit-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        justify-content: flex-end;
    }
    .defect-qty-input {
        width: 78px !important;
        height: 28px !important;
        font-size: 12px !important;
        text-align: right;
        padding: 2px 6px !important;
    }
    .defect-note-input {
        width: 150px !important;
        height: 28px !important;
        font-size: 12px !important;
        padding: 2px 8px !important;
    }
    .defect-save-btn {
        height: 28px !important;
        padding: 0 10px !important;
        line-height: 26px !important;
        font-size: 12px !important;
        white-space: nowrap;
    }

    .print-signatures { display: none; }
    .print-header { display: none; }

    @@media print {
        @@page { margin: 10mm; }
        body { background: #fff !important; color: #000 !important; }
        .sidebar, .page-actions, form { display: none !important; }
        .no-print { display: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .card { border: 1px solid #000 !important; box-shadow: none !important; background: transparent !important; }
        .card-header { background: transparent !important; color: #000 !important; border-bottom: 1px solid #000 !important; }
        .card-title { color: #000 !important; }
        .text-accent, .text-success, .text-danger, .text-info, .text-warning, .text-muted { color: #000 !important; }
        table th { background: #eee !important; color: #000 !important; border: 1px solid #000 !important; }
        table td { border: 1px solid #000 !important; color: #000 !important; }
        .badge { color: #000 !important; border: 1px solid #999 !important; background: transparent !important; }
        .badge-purple { color: #000; border: 1px solid #000; background: transparent; }
        .print-signatures { display: block !important; }
        .print-signatures table td { border: none !important; }
        .print-header { display: block !important; margin-bottom: 15px; text-align: center; }

        /* Ngày tháng góc phải */
        .page-header { text-align: center !important; display: block !important; }
        .page-title { font-size: 22px !important; }
    }
</style>

@section Scripts {
<script>
    // ═══ Kiểm Kho & Tăng Tồn (Approve) ═══
    document.getElementById('approveBtn')?.addEventListener('click', function() {
        const rows = Array.from(document.querySelectorAll('table tbody tr'));
        let totalTrans = 0;
        let totalDefectTrans = 0;
        let totalBase = 0;          // used for optional “quy đổi”
        let totalDefectBase = 0;    // used for optional “quy đổi”
        for (const r of rows) {
            const cells = r.querySelectorAll('td');
            if (!cells || cells.length === 0) continue;

            // Heuristic: BaseQty + Defect nằm trong các cột số; dùng data-qty nếu có, fallback parse text
            const baseCell = r.querySelector('[data-base-qty]') || null;
            const defectCell = r.querySelector('[data-defect-qty]') || null;
            const transCell = r.querySelector('[data-trans-qty]') || null;
            const defectTransCell = r.querySelector('[data-defect-trans-qty]') || null;
            const parseNum = (t) => {
                if (!t) return 0;
                let s = ('' + t).trim();
                if (!s) return 0;
                // keep digits and common separators only
                s = s.replace(/[^0-9,.\-]/g, '');
                if (!s || s === '-' || s === ',' || s === '.') return 0;

                const hasDot = s.indexOf('.') >= 0;
                const hasComma = s.indexOf(',') >= 0;

                // Decide decimal separator:
                // - If both exist, the last one is assumed to be decimal
                // - If only one exists:
                //    - multiple occurrences => thousands separators
                //    - single occurrence:
                //        - 3 digits after => likely thousands
                //        - otherwise => decimal
                let normalized = s;
                if (hasDot && hasComma) {
                    const lastDot = s.lastIndexOf('.');
                    const lastComma = s.lastIndexOf(',');
                    const decIsDot = lastDot > lastComma;
                    if (decIsDot) {
                        normalized = s.replace(/,/g, '');
                    } else {
                        normalized = s.replace(/\./g, '').replace(',', '.');
                    }
                } else if (hasDot || hasComma) {
                    const sep = hasDot ? '.' : ',';
                    const parts = s.split(sep);
                    if (parts.length > 2) {
                        // many separators => thousands
                        normalized = s.replace(/[.,]/g, '');
                    } else {
                        const frac = parts[1] ?? '';
                        if (frac.length === 3 && parts[0].length >= 1) {
                            // 1.000 / 10,000 => thousands
                            normalized = s.replace(/[.,]/g, '');
                        } else {
                            // treat as decimal
                            normalized = parts[0] + '.' + frac;
                        }
                    }
                }

                // remove any stray minus signs except leading
                normalized = normalized.replace(/(?!^)-/g, '');
                const n = parseFloat(normalized);
                return isNaN(n) ? 0 : n;
            };

            const base = baseCell ? parseNum(baseCell.getAttribute('data-base-qty')) : 0;
            const defectBase = defectCell ? parseNum(defectCell.getAttribute('data-defect-qty')) : 0;
            const trans = transCell ? parseNum(transCell.getAttribute('data-trans-qty')) : 0;
            const defectTrans = defectTransCell ? parseNum(defectTransCell.getAttribute('data-defect-trans-qty')) : 0;

            totalBase += base;
            totalDefectBase += defectBase;
            totalTrans += trans;
            totalDefectTrans += defectTrans;
        }
        const totalGoodTrans = Math.max(0, totalTrans - totalDefectTrans);
        const totalGoodBase = Math.max(0, totalBase - totalDefectBase);
        const hasConversion = Math.abs(totalBase - totalTrans) > 0.000001 || Math.abs(totalDefectBase - totalDefectTrans) > 0.000001;

        Swal.fire({
            title: 'Xác nhận tăng tồn?',
            html: '<div style="text-align:left;font-size:14px;line-height:1.9;">' +
                  '<div style="margin-bottom:8px;"><i class="fas fa-check-circle" style="color:#4ade80;"></i> Hệ thống sẽ <b>cộng tồn kho</b> theo số lượng thực nhận.</div>' +
                  '<div style="padding:10px 12px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);">' +
                  '<div><b>Tổng SL (chứng từ):</b> ' + (totalTrans || 0).toLocaleString('vi-VN') + '</div>' +
                  '<div><b>SL tăng tồn (ĐVT tồn):</b> <span style="color:#4ade80;">' + (totalGoodBase || 0).toLocaleString('vi-VN') + '</span></div>' +
                  (hasConversion
                      ? ('<div style="margin-top:6px;color:#94a3b8;font-size:12px;">' +
                         '<i class="fas fa-exchange-alt"></i> SL tăng tồn (chứng từ): ' +
                         (totalGoodTrans || 0).toLocaleString('vi-VN') +
                         '</div>')
                      : '') +
                  '</div>' +
                  '<div style="margin-top:8px;color:#94a3b8;font-size:12px;"><i class="fas fa-info-circle"></i> Sai lệch (nếu có) đã được nhập ở từng dòng bằng nút Lưu lệch.</div>' +
                  '<div style="margin-top:4px;color:#94a3b8;font-size:12px;"><i class="fas fa-user-check"></i> Người kiểm phải khác người lập phiếu.</div>' +
                  '</div>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-check-double"></i> Xác nhận tăng tồn',
            cancelButtonText: '<i class="fas fa-times"></i> Hủy',
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#6b7280',
            background: '#1a1f2e',
            color: '#e2e8f0',
            customClass: { popup: 'swal-dark' }
        }).then((result) => {
            if (result.isConfirmed) {
                const hasDefect = totalDefectBase > 0.000001 || totalDefectTrans > 0.000001;
                const data = hasDefect
                    ? {
                        reviewResult: 3,
                        responsibilityScore: 1,
                        reviewNote: 'Đã có sai lệch và đã lưu chỉnh tại dòng chi tiết trước khi tăng tồn.'
                    }
                    : {
                        reviewResult: 2,
                        responsibilityScore: 0,
                        reviewNote: 'Đạt - không sai lệch.'
                    };
                const reviewResultInput = document.getElementById('reviewResultInput');
                const responsibilityScoreInput = document.getElementById('responsibilityScoreInput');
                const reviewNoteInput = document.getElementById('reviewNoteInput');
                if (reviewResultInput) reviewResultInput.value = String(data.reviewResult);
                if (responsibilityScoreInput) responsibilityScoreInput.value = String(data.responsibilityScore);
                if (reviewNoteInput) reviewNoteInput.value = data.reviewNote || '';
                document.getElementById('approveForm').submit();
            }
        });
    });

    // ═══ Hủy Phiếu (Cancel) ═══
    document.getElementById('cancelBtn')?.addEventListener('click', function() {
        const reason = document.getElementById('cancelReasonInput').value.trim();
        if (!reason) {
            Swal.fire({
                title: 'Thiếu lý do!',
                text: 'Vui lòng nhập lý do hủy phiếu trước.',
                icon: 'warning',
                confirmButtonText: 'Đã hiểu',
                confirmButtonColor: '#f59e0b',
                background: '#1a1f2e',
                color: '#e2e8f0'
            });
            return;
        }
        Swal.fire({
            title: 'Hủy phiếu này?',
            html: '<div style="text-align:left;font-size:14px;line-height:1.8;">' +
                  '<i class="fas fa-exclamation-triangle" style="color:#f87171;"></i> Hủy phiếu sẽ <b>hoàn tác (reverse)</b> toàn bộ tồn kho<br>' +
                  '<i class="fas fa-undo" style="color:#fbbf24;"></i> Tất cả số lượng sẽ được trả về trạng thái trước phiếu</div>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-trash"></i> Xác nhận hủy',
            cancelButtonText: '<i class="fas fa-times"></i> Không hủy',
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            background: '#1a1f2e',
            color: '#e2e8f0',
            customClass: { popup: 'swal-dark' }
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('cancelForm').submit();
            }
        });
    });


</script>
}
