@model List<WMS.ViewModels.PickTaskBoardRow>
@{
    ViewData["Title"] = "Nhiệm vụ lấy hàng";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Nhiệm vụ lấy hàng</h1>
        <p class="page-subtitle">Theo dõi, gán người làm và xác nhận số lượng đã lấy.</p>
    </div>
</div>

<div class="user-guide">
    <div class="user-guide-title"><i class="fas fa-hand-point-right"></i> Cách dùng nhanh</div>
    <div class="step-list">
        <span class="step-chip"><i class="fas fa-filter"></i> 1) Lọc theo đợt/Trạng thái</span>
        <span class="step-chip"><i class="fas fa-user-plus"></i> 2) Gán người thực hiện</span>
        <span class="step-chip"><i class="fas fa-barcode"></i> 3) Scan và nhập số lượng đã lấy</span>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="form-group">
        <label class="form-label">Đợt lấy hàng (Wave)</label>
        <select class="form-control" name="waveId">
            <option value="">-- Tất cả --</option>
            @foreach (var w in (List<WMS.Models.Wave>)ViewBag.Waves)
            {
                <option value="@w.WaveId" selected="@(ViewBag.WaveId != null && (long)ViewBag.WaveId == w.WaveId)">@w.WaveCode</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Trạng thái</label>
        <select class="form-control" name="status">
            <option value="">-- Tất cả --</option>
            <option value="1" selected="@(ViewBag.Status != null && (byte)ViewBag.Status == 1)">Mới tạo</option>
            <option value="2" selected="@(ViewBag.Status != null && (byte)ViewBag.Status == 2)">Đã gán</option>
            <option value="3" selected="@(ViewBag.Status != null && (byte)ViewBag.Status == 3)">Đang lấy</option>
            <option value="4" selected="@(ViewBag.Status != null && (byte)ViewBag.Status == 4)">Hoàn tất</option>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button class="btn btn-primary" type="submit">Tìm dữ liệu</button>
    </div>
</form>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>Mã nhiệm vụ</th>
                <th>Đợt</th>
                <th>Phiếu</th>
                <th>Vật tư</th>
                <th>Vị trí</th>
                <th>Yêu cầu / Đã lấy</th>
                <th>Trạng thái</th>
                <th>Người làm</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-center text-muted" style="padding:30px;">Chưa có nhiệm vụ.</td></tr>
            }
            else
            {
                foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TaskCode</td>
                        <td>@t.WaveCode</td>
                        <td>@t.VoucherCode</td>
                        <td>@t.ItemCode</td>
                        <td>@t.LocationCode</td>
                        <td>@t.TargetQty.ToString("N0") / @t.PickedQty.ToString("N0")</td>
                        <td>@(t.Status switch {1 => "Mới tạo", 2 => "Đã gán", 3 => "Đang lấy", 4 => "Hoàn tất", 5 => "Thiếu hàng", 6 => "Đã hủy", _ => "N/A"})</td>
                        <td>@(t.AssignedTo ?? "-")</td>
                        <td>
                            @if (t.Status is 1 or 2)
                            {
                                <form method="post" action="/Operations/AssignTask" style="display:flex;gap:6px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.PickTaskId" />
                                    <input class="form-control" name="assignedTo" placeholder="Tên đăng nhập" style="min-width:120px;" />
                                    <button class="btn btn-secondary" type="submit">Gán nhiệm vụ</button>
                                </form>
                            }
                            @if (t.Status is 1 or 2 or 3)
                            {
                                <form method="post" action="/Vouchers/ConfirmPickTask" style="display:flex;gap:6px;margin-top:6px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.PickTaskId" />
                                    <input class="form-control" name="scanValue" placeholder="Mã vạch / Số lô" style="min-width:120px;" />
                                    <input class="form-control" type="number" step="0.0001" min="0.0001" max="@((t.TargetQty - t.PickedQty).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture))" name="qty" placeholder="Số lượng" style="width:90px;" />
                                    <button class="btn btn-primary" type="submit">Xác nhận lấy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

