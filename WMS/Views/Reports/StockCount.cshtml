@model WMS.ViewModels.StockCountPageViewModel
@{
    ViewData["Title"] = "Kiểm kê vị trí";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Phiếu kiểm kê theo vị trí/lô</h1>
        <p class="page-subtitle">Quy trình 2 bước: nhập đếm tạo phiếu nháp, Manager/Admin duyệt để sinh phiếu điều chỉnh chênh lệch.</p>
    </div>
</div>

<div class="user-guide">
    <div class="user-guide-title"><i class="fas fa-circle-info"></i> Quy trình kiểm kê cho người mới</div>
    <div class="step-list">
        <span class="step-chip"><i class="fas fa-download"></i> 1) Tải dữ liệu tồn</span>
        <span class="step-chip"><i class="fas fa-edit"></i> 2) Nhập số đếm thực tế</span>
        <span class="step-chip"><i class="fas fa-user-check"></i> 3) Manager/Admin duyệt</span>
    </div>
</div>

<form method="get" class="filter-bar">
    <div class="form-group">
        <label class="form-label">Kho *</label>
        <select name="warehouseId" class="form-control" required>
            <option value="">-- Chọn kho --</option>
            @foreach (var w in Model.Warehouses)
            {
                <option value="@w.WarehouseId" selected="@(Model.WarehouseId == w.WarehouseId)">@w.WarehouseCode - @w.WarehouseName</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Ngày kiểm kê</label>
        <input type="date" name="countDate" class="form-control" value="@Model.CountDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="form-group">
        <label class="form-label">&nbsp;</label>
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Tải dữ liệu</button>
    </div>
</form>

@if (Model.WarehouseId.HasValue)
{
    <form method="post" action="/Reports/StockCountSaveDraft">
        @Html.AntiForgeryToken()
        <input type="hidden" name="WarehouseId" value="@Model.WarehouseId" />
        <input type="hidden" name="CountDate" value="@Model.CountDate.ToString("yyyy-MM-dd")" />

        <div class="card mb-3">
            <div class="card-body">
                <label class="form-label">Ghi chú</label>
                <input type="text" name="Notes" class="form-control" value="@Model.Notes" placeholder="Ví dụ: kiểm kê cuối tháng" />
            </div>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Mã VT</th>
                        <th>Tên vật tư</th>
                        <th>Vị trí</th>
                        <th>Số lô</th>
                        <th>Hạn dùng</th>
                        <th style="text-align:right;">SL hệ thống</th>
                        <th style="text-align:right;">SL thực tế</th>
                        <th style="text-align:right;">Chênh lệch</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Lines.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted" style="padding:30px;">Không có tồn để kiểm kê cho kho đã chọn.</td></tr>
                    }
                    else
                    {
                        for (var i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];
                            <tr>
                                <td>@line.ItemCode<input type="hidden" name="Lines[@i].ItemId" value="@line.ItemId" /></td>
                                <td>@line.ItemName</td>
                                <td>@line.LocationCode<input type="hidden" name="Lines[@i].LocationId" value="@line.LocationId" /></td>
                                <td>@(line.LotNumber ?? "-")<input type="hidden" name="Lines[@i].LotNumber" value="@line.LotNumber" /></td>
                                <td>@(line.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")<input type="hidden" name="Lines[@i].ExpiryDate" value="@line.ExpiryDate?.ToString("yyyy-MM-dd")" /></td>
                                <td class="td-number">@line.SystemQty.ToString("N2")<input type="hidden" name="Lines[@i].SystemQty" value="@line.SystemQty" /></td>
                                <td style="width:160px;">
                                    <input type="number" min="0" step="0.0001" class="form-control counted-input" name="Lines[@i].CountedQty" value="@line.CountedQty.ToString("0.####")" />
                                </td>
                                <td class="td-number diff-cell">@((line.CountedQty - line.SystemQty).ToString("N2"))</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Lines.Any())
        {
            <div class="mt-3">
                <button type="submit" class="btn btn-warning" id="generateAdjustBtn">
                    <i class="fas fa-save"></i> Lưu nháp kiểm kê
                </button>
            </div>
        }
    </form>

    <div class="card mt-3">
        <div class="card-header">
            <strong>Phiếu kiểm kê trong ngày</strong>
        </div>
        <div class="card-body">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Người tạo</th>
                            <th>Thời điểm tạo</th>
                            <th>Dòng / lệch</th>
                            <th>Trạng thái</th>
                            <th>Người duyệt</th>
                            <th>Phiếu điều chỉnh</th>
                            <th>Lý do duyệt</th>
                            <th>Lần mở khóa gần nhất</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ExistingSheets.Any())
                        {
                            <tr><td colspan="10" class="text-center text-muted" style="padding:20px;">Chưa có phiếu kiểm kê nào cho ngày đã chọn.</td></tr>
                        }
                        else
                        {
                            foreach (var s in Model.ExistingSheets)
                            {
                                var canApprove = s.Status == 1 && (User.IsInRole("Admin") || User.IsInRole("Manager"));
                                var canUnlock = s.Status == 2 && User.IsInRole("Admin");
                                <tr>
                                    <td>#@s.StockCountSheetId</td>
                                    <td>@s.CreatedBy</td>
                                    <td>@s.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@s.TotalLines / @s.DiffLines</td>
                                    <td>@(s.Status == 1 ? "Nháp chờ duyệt" : "Đã duyệt")</td>
                                    <td>@(s.ApprovedBy ?? "-")</td>
                                    <td>@(s.VoucherCode ?? "-")</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.ApprovalReason) ? "-" : s.ApprovalReason)</td>
                                    <td>@(string.IsNullOrWhiteSpace(s.UnlockedBy) ? "-" : $"{s.UnlockedBy} - {s.UnlockedAt?.ToLocalTime():dd/MM HH:mm}")</td>
                                    <td>
                                        @if (canApprove)
                                        {
                                            <form method="post" action="/Reports/StockCountApproveDraft" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.StockCountSheetId" />
                                                <input type="text" name="approvalReason" class="form-control" placeholder="Lý do duyệt" required maxlength="500" style="min-width:220px;margin-bottom:6px;" />
                                                <button type="submit" class="btn btn-primary">Duyệt</button>
                                            </form>
                                        }
                                        @if (canUnlock)
                                        {
                                            <form method="post" action="/Reports/StockCountUnlockApproved" style="display:inline;margin-top:6px;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.StockCountSheetId" />
                                                <input type="text" name="unlockReason" class="form-control" placeholder="Lý do mở khóa" required maxlength="500" style="min-width:220px;margin-bottom:6px;" />
                                                <button type="submit" class="btn btn-danger">Mở khóa</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
document.addEventListener('input', function(e) {
    if (!e.target.classList.contains('counted-input')) return;
    const row = e.target.closest('tr');
    if (!row) return;
    const sysInput = row.querySelector('input[name$=".SystemQty"]');
    const sys = parseFloat(sysInput?.value || '0') || 0;
    const counted = parseFloat(e.target.value || '0') || 0;
    const diff = counted - sys;
    const cell = row.querySelector('.diff-cell');
    if (cell) cell.innerText = diff.toLocaleString('vi-VN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
});
</script>
}

