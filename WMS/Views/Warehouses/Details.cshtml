@model WMS.Models.Warehouse
@{ ViewData["Title"] = $"Sơ Đồ: {Model.WarehouseName}"; }
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-warehouse text-accent"></i> @Model.WarehouseName</h1>
        <p class="page-subtitle">Sơ đồ và cấu trúc hiển thị khu vực lưu trữ (Zone) & vị trí (Location)</p>
        <div style="margin-top:8px;font-size:13px;color:var(--text-muted);">
            <i class="fas fa-map-marker-alt"></i> @Model.Address | 
            <i class="fas fa-user"></i> @(Model.ManagerUser != null ? Model.ManagerUser.FullName : (string.IsNullOrEmpty(Model.ManagerName) ? "---" : Model.ManagerName)) - @Model.Phone
        </div>
    </div>
    <div class="page-actions">
        <a href="/Warehouses" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Danh sách kho</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><span class="card-title"><i class="fas fa-map-marked-alt text-primary"></i> Bản Đồ Vị Trí Kho (Leaflet)</span></div>
    <div class="card-body" style="padding:0;">
        <div id="warehouseMap" style="height: 350px; width: 100%; z-index: 1;"></div>
    </div>
</div>





<!-- Modal Thêm Location -->
<div class="modal-overlay" id="modalLoc">
    <div class="modal">
        <form method="post" action="/Warehouses/CreateLocation">
            @Html.AntiForgeryToken()
            <input type="hidden" name="zoneId" id="locZoneId" value="" />
            <div class="modal-header">
                <div class="modal-title">Thêm Vị Trí (Location) vào <span class="text-accent" id="locZoneName"></span></div>
                <button type="button" class="modal-close" onclick="document.getElementById('modalLoc').classList.remove('active')">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label">Mã Vị Trí (Location Code) *</label>
                    <input type="text" name="locationCode" class="form-control" required placeholder="VD: A1-01-01" />
                    <small class="text-muted" style="font-size:11px;">Mã định danh duy nhất (VD: dùng để in Barcode/QR)</small>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Cột/Dãy (Rack)</label>
                        <input type="text" name="rackCode" class="form-control" placeholder="A1" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tầng (Shelf)</label>
                        <input type="text" name="shelfCode" class="form-control" placeholder="01" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Ô/Hộc (Bin)</label>
                        <input type="text" name="binCode" class="form-control" placeholder="01" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalLoc').classList.remove('active')">Hủy</button>
                <button type="submit" class="btn btn-primary">Thêm Vị Trí</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Xem Tồn Kho Vị Trí -->
<div class="modal-overlay" id="modalStock">
    <div class="modal" style="max-width: 650px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-boxes text-info"></i> Tồn Kho Tại: <span class="text-accent" id="stockLocName"></span></div>
            <button type="button" class="modal-close" onclick="document.getElementById('modalStock').classList.remove('active')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 0;">
            <div class="table-container flat scroll-y">
                <table style="margin:0; width:100%;">
                    <thead>
                        <tr>
                            <th style="width:18%">Mã VT</th>
                            <th style="width:43%">Tên Vật Tư</th>
                            <th style="width:18%; text-align:right;">Số Lượng</th>
                            <th style="width:18%">ĐVT</th>
                        </tr>
                    </thead>
                    <tbody id="stockTbody">
                        <tr><td colspan="5" class="text-center font-italic text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer" style="padding: 12px 20px; display: flex; justify-content: space-between; align-items: center;">
            <div style="display:flex; gap:8px;">
                <a href="/Vouchers/Create?type=6" class="btn btn-sm btn-info" title="Chuyển vật tư sang vị trí/kho khác"><i class="fas fa-exchange-alt"></i> Luân chuyển</a>
                <a href="/Vouchers/Create?type=5" class="btn btn-sm btn-warning" title="Điều chỉnh/kiểm kê số lượng thực tế"><i class="fas fa-sliders-h"></i> Điều chỉnh</a>
            </div>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('modalStock').classList.remove('active')">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var map = L.map('warehouseMap').setView([10.762622, 106.660172], 12); // Default to HCMC

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        var addressQuery = '@Html.Raw(Model.Address ?? Model.WarehouseName)'.replace(/ \/ /g, ' ').replace(/-/g, ' ');
        if (addressQuery && addressQuery !== '---') {
            fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(addressQuery))
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        var lat = parseFloat(data[0].lat);
                        var lon = parseFloat(data[0].lon);
                        map.setView([lat, lon], 15);
                        L.marker([lat, lon]).addTo(map)
                            .bindPopup('<b style="color:#0f172a;">@Model.WarehouseName</b><br><span style="color:#0f172a;">@Model.Address</span>')
                            .openPopup();
                    } else {
                        console.log("Geocoding failed for: " + addressQuery);
                        L.marker([10.762622, 106.660172]).addTo(map)
                            .bindPopup('<b style="color:#0f172a;">@Model.WarehouseName</b><br><span style="color:#0f172a;">(Vị trí mặc định - Không tìm thấy địa chỉ chính xác)</span>')
                            .openPopup();
                    }
                }).catch(e => console.log('Geocode error', e));
        }
    });

    function openLocationModal(zoneId, zoneCode) {
        document.getElementById('locZoneId').value = zoneId;
        document.getElementById('locZoneName').innerText = zoneCode;
        document.getElementById('modalLoc').classList.add('active');
    }

    async function openStockModal(locId, locCode) {
        document.getElementById('stockLocName').innerText = locCode;
        document.getElementById('stockTbody').innerHTML = '<tr><td colspan="5" class="text-center font-italic text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>';
        document.getElementById('modalStock').classList.add('active');

        try {
            const res = await fetch(`/Warehouses/GetLocationStock?locationId=${locId}`);
            if (res.ok) {
                const data = await res.json();
                if (data && data.length > 0) {
                    let html = '';
                    data.forEach(item => {
                        html += `<tr>
                            <td class="td-code text-accent">${item.itemCode || '---'}</td>
                            <td class="td-name">${item.itemName || '---'}</td>
                            <td class="td-number fw-600 text-success">${Number(item.quantity).toLocaleString('vi-VN')}</td>
                            <td>${item.uom || '---'}</td>
                        </tr>`;
                    });
                    document.getElementById('stockTbody').innerHTML = html;
                } else {
                    document.getElementById('stockTbody').innerHTML = '<tr><td colspan="5" class="text-center font-italic text-muted" style="padding:20px;"><i class="fas fa-box-open" style="font-size:24px; color:var(--text-muted); display:block; margin-bottom:8px;"></i> Vị trí này hiện đang trống (không có hàng).</td></tr>';
                }
            } else {
                document.getElementById('stockTbody').innerHTML = '<tr><td colspan="5" class="text-center text-danger">Lỗi kết nối máy chủ!</td></tr>';
            }
        } catch (e) {
            document.getElementById('stockTbody').innerHTML = '<tr><td colspan="5" class="text-center text-danger">Lỗi mạng hoặc tải dữ liệu thất bại!</td></tr>';
            console.error(e);
        }
    }
</script>
}
