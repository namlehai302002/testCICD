@model WMS.Models.Item
@{ ViewData["Title"] = "Chi Tiết Vật Tư"; }

<div class="page-header">
    <div>
        <h1 class="page-title">@Model.ItemName</h1>
        <p class="page-subtitle">Mã: @Model.ItemCode @(string.IsNullOrEmpty(Model.Barcode) ? "" : $"| MÃ VẠCH: {Model.Barcode}")</p>
    </div>
    <div class="page-actions">
        <!-- New Print Button -->
        <button type="button" class="btn btn-info" onclick="openPrintModal()"><i class="fas fa-print"></i> In Tem Nhãn</button>
        <a href="/Items/Edit/@Model.ItemId" class="btn btn-primary"><i class="fas fa-edit"></i> Chỉnh Sửa</a>
        <a href="/Items" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
    </div>
</div>

<!-- Print Label Modal -->
<div id="printModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:#fff; width:360px; border-radius:8px; padding:20px; box-shadow:0 4px 20px rgba(0,0,0,0.2);">
        <h4 style="margin-top:0; color:#333; text-align:center; border-bottom:1px solid #ccc; padding-bottom:10px;">In Tem Nhãn Vật Tư</h4>
        
        <div id="printArea" style="padding:15px; text-align:center; border:2px dashed #ccc; margin-bottom:20px; background:#fff; color:#000;">
            <div style="font-size:16px; font-weight:bold; margin-bottom:5px; text-transform:uppercase;">@Model.ItemName</div>
            <div style="font-size:12px; margin-bottom:10px;">Mã VT: @Model.ItemCode</div>
            <svg id="barcodeTarget"></svg>
            <div style="font-size:11px; margin-top:5px;">@Model.Category?.CategoryName - @(Model.BaseUom?.UomName)</div>
        </div>

        <div style="display:flex; justify-content:space-between;">
            <button type="button" class="btn btn-secondary" onclick="closePrintModal()">Hủy</button>
            <button type="button" class="btn btn-success" onclick="printLabel()"><i class="fas fa-print"></i> Xác Nhận In</button>
        </div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <div class="card-header"><span class="card-title">Thông Tin Cơ Bản</span></div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">Danh Mục</div>
                    <div class="detail-value">@(Model.Category?.CategoryName ?? "---")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Loại</div>
                    <div class="detail-value"><span class="badge badge-purple">@Model.ItemTypeName</span></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Đơn Vị Tính</div>
                    <div class="detail-value">@(Model.BaseUom?.UomName ?? "---") (@(Model.BaseUom?.UomCode))</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">SKU / Khác</div>
                    <div class="detail-value">@(string.IsNullOrEmpty(Model.SkuCode) ? "---" : Model.SkuCode)</div>
                </div>
                @if (Model.Weight.HasValue)
                {
                    <div class="detail-item">
                        <div class="detail-label">Khối Lượng</div>
                        <div class="detail-value">@Model.Weight.Value.ToString("N4") kg</div>
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.Description) || !string.IsNullOrEmpty(Model.Specifications))
            {
                <div class="mt-3">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="detail-label">Mô tả</div>
                        <p style="font-size:13px; color:var(--text-secondary); margin-bottom:12px;">@Model.Description</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Specifications))
                    {
                        <div class="detail-label">Thông số kỹ thuật</div>
                        <p style="font-size:13px; color:var(--text-secondary);">@Model.Specifications</p>
                    }
                </div>
            }
        </div>
    </div>
    
    <div class="card">
        <div class="card-header"><span class="card-title">Thông Tin Tồn Kho</span></div>
        <div class="card-body">
            <div class="detail-grid">
                <div class="detail-item">
                    <div class="detail-label">Tồn Kho Hiện Tại</div>
                    <div class="detail-value text-accent" style="font-size:24px;">@Model.CurrentStock.ToString("N2") <span style="font-size:14px;">@Model.BaseUom?.UomCode</span></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Giá Trị Tồn Kho</div>
                    <div class="detail-value text-success" style="font-size:24px;">@Model.TotalStockValue.ToString("N0") <span style="font-size:14px;">VNĐ</span></div>
                </div>
            </div>
            
            <div class="detail-grid mt-3">
                <div class="detail-item">
                    <div class="detail-label">Mức Tối Thiểu</div>
                    <div class="detail-value">@Model.MinThreshold.ToString("N2")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Mức Tối Đa</div>
                    <div class="detail-value">@(Model.MaxThreshold?.ToString("N2") ?? "---")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Điểm Đặt Hàng</div>
                    <div class="detail-value">@(Model.ReorderPoint?.ToString("N2") ?? "---")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Giá Vốn (BQGQ)</div>
                    <div class="detail-value">@Model.UnitCost.ToString("N0") VNĐ</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header"><span class="card-title"><i class="fas fa-map-marker-alt text-warning"></i> Chi Tiết Tồn Theo Vị Trí</span></div>
    <div class="table-container flat">
        <table>
            <thead>
                <tr>
                    <th>Kho</th><th>Khu Vực</th><th>Vị Trí</th><th>Hạn Dùng</th><th style="text-align:right;">Số Lượng</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.Locations != null && ((List<WMS.Models.ItemLocation>)ViewBag.Locations).Any())
                {
                    @foreach (var il in (List<WMS.Models.ItemLocation>)ViewBag.Locations)
                    {
                        <tr>
                            <td>@il.Location?.Zone?.Warehouse?.WarehouseName</td>
                            <td>@il.Location?.Zone?.ZoneName</td>
                            <td class="td-code text-accent">@il.Location?.LocationCode</td>
                            <td>@(il.ExpiryDate?.ToString("dd/MM/yyyy") ?? "---")</td>
                            <td class="td-number fw-600">@il.Quantity.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted" style="padding:30px;">Chưa có dữ liệu tồn vị trí</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header"><span class="card-title"><i class="fas fa-history text-info"></i> Lịch Sử Lịch Sử Giao Dịch (20 phiếu gần nhất)</span></div>
    <div class="table-container flat">
        <table>
            <thead>
                <tr>
                    <th>Ngày Phiếu</th><th>Mã Phiếu</th><th>Loại Giao Dịch</th><th>Kho</th><th style="text-align:right;">Số Lượng</th><th style="text-align:right;">Đơn Giá</th><th style="text-align:right;">Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (ViewBag.RecentVouchers != null && ((List<WMS.Models.VoucherDetail>)ViewBag.RecentVouchers).Any())
                {
                    @foreach (var vd in (List<WMS.Models.VoucherDetail>)ViewBag.RecentVouchers)
                    {
                        var isCancel = vd.Voucher!.IsCancelled;
                        <tr>
                            <td style="@(isCancel ? "text-decoration:line-through;color:var(--danger);" : "")">@vd.Voucher?.VoucherDate.ToString("dd/MM/yyyy")</td>
                            <td><a href="/Vouchers/Details/@vd.VoucherId" class="td-code" style="text-decoration:none; @(isCancel?"text-decoration:line-through;color:var(--danger);":"")">@vd.Voucher?.VoucherCode</a></td>
                            <td>
                                <span class="badge @(isCancel ? "badge-danger" : "badge-info")">@(isCancel ? "Đã Hủy" : vd.Voucher?.VoucherTypeName)</span>
                            </td>
                            <td>@vd.Voucher?.Warehouse?.WarehouseName</td>
                            <td class="td-number @(vd.Voucher?.VoucherType is 1 or 4 or 7 ? "text-success" : vd.Voucher?.VoucherType is 2 or 3 or 8 ? "text-danger" : "") fw-600">
                                @(vd.Voucher?.VoucherType is 1 or 4 or 7 ? "+" : vd.Voucher?.VoucherType is 2 or 3 or 8 ? "-" : "")@vd.BaseQty.ToString("N2")
                            </td>
                            <td class="td-number">@vd.UnitPrice.ToString("N0")</td>
                            <td class="td-number">@vd.LineAmount.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted" style="padding:30px;">Chưa có lịch sử giao dịch</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Include JsBarcode for client-side barcode generation -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        const itemBarcode = '@Html.Raw(string.IsNullOrEmpty(Model.Barcode) ? Model.ItemCode : Model.Barcode)';

        function openPrintModal() {
            document.getElementById('printModal').style.display = 'flex';
            try {
                JsBarcode("#barcodeTarget", itemBarcode, {
                    format: "CODE128",
                    lineColor: "#000",
                    width: 2,
                    height: 50,
                    displayValue: true,
                    fontSize: 14,
                    margin: 10
                });
            } catch (err) {
                console.error("Barcode generation failed:", err);
            }
        }

        function closePrintModal() {
            document.getElementById('printModal').style.display = 'none';
        }

        function printLabel() {
            const printContent = document.getElementById('printArea').innerHTML;
            const printWindow = window.open('', '_blank', 'width=600,height=600');
            printWindow.document.write('<html><head><title>In Tem Nhãn WMS</title>');
            printWindow.document.write('<style>');
            printWindow.document.write('body { font-family: Tahoma, sans-serif; display: flex; justify-content: center; align-items:flex-start; padding-top:20px; background:#f0f0f0; margin: 0; }');
            printWindow.document.write('.label-box { width: 300px; background:#fff; text-align: center; border: 1px solid #000; padding: 15px; margin: 0 auto; }');
            printWindow.document.write('@@media print { body { background:#fff; padding:0; align-items:center; } .label-box { border: none !important; } }');
            printWindow.document.write('</style></head><body>');
            printWindow.document.write('<div class="label-box">');
            printWindow.document.write(printContent);
            printWindow.document.write('</div></body></html>');
            printWindow.document.close();
            
            printWindow.focus();
            setTimeout(() => {
                printWindow.print();
                printWindow.close();
                closePrintModal();
            }, 300);
        }
    </script>
}
